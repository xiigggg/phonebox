#!/sbin/sh
# Magisk 官方模块模板的安装入口（KernelSU / APatch 不用它）
umask 022
OUTFD=$2
ZIPFILE=$3
ui_print() { echo "$1"; }
require_new_magisk() {
  ui_print "*******************************"
  ui_print " 请先安装 Magisk v20.4 或更新版本 "
  ui_print "*******************************"
  exit 1
}
mount /data 2>/dev/null
[ -f /data/adb/magisk/util_functions.sh ] || require_new_magisk
. /data/adb/magisk/util_functions.sh
[ "$MAGISK_VER_CODE" -lt 20400 ] && require_new_magisk
install_module
exit 0

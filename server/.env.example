# 电话信箱服务端配置。复制成 .env 后修改，再运行 scripts/init.sh。
# 口令不写在这里：init.sh 会随机生成到 secrets/ 下。
# 值里不要出现引号以外的特殊字符或换行；含空格的值用双引号括起来。

# ---- 基本 ----
COMPOSE_PROJECT_NAME=phonebox
# 接了 4G 模块后取消注释，让容器拿到串口
#COMPOSE_FILE=docker-compose.yml:docker-compose.ec20.yml
# 数据目录：通话/短信记录、号码库、模型、Asterisk 日志与语音信箱
DATA_DIR=./data
TZ=Asia/Shanghai
# 构建 asterisk 镜像时的 Ubuntu 镜像站，留空用官方源；例：http://mirrors.tuna.tsinghua.edu.cn/ubuntu
APT_MIRROR=

# ---- SIP ----
# 手机从外网连接用的域名（TLS 证书 CN/SAN 也用它）
SIP_DOMAIN=sip.example.com
# 额外 SAN，多个用空格隔开，例："IP:192.168.1.10 DNS:nas.lan"（局域网直连也要过证书校验时填）
TLS_EXTRA_SAN=
# 公网地址（域名或 IP）。在 NAT 后面且要从外网用时填，留空表示不做 NAT 改写（纯局域网）
EXTERNAL_ADDRESS=
# 局域网网段，NAT 改写时对它不改写
LOCAL_NET=192.168.1.0/24
# 监听地址：0.0.0.0 = 所有网卡；只在本机测试可填 127.0.0.1
SIP_BIND=0.0.0.0
SIP_UDP_PORT=5060
# 路由器上 UDP 对外端口（只有填了 EXTERNAL_ADDRESS 才用到）
SIP_UDP_PUBLIC_PORT=5060
SIP_TLS_PORT=5061
# 路由器上 TLS 对外端口，必须和端口转发一致
SIP_TLS_PUBLIC_PORT=5061
# 额外开 TCP 传输（和 UDP 同端口），App 用 TLS 时不需要
SIP_TCP=no
# RTP 媒体端口段，路由器需要转发同样的 UDP 范围
RTP_START=10000
RTP_END=10050

# ---- 分机 ----
# App 使用的分机（SDES SRTP 可选，离线时走短信唤醒）
APP_EXT=101
# yes = Asterisk 呼叫 App 分机时固定走 TLS（App 若经 UDP 注册，来电会送不到）；先确认 App 在 TLS 下稳定再打开。
# 注意：它不能阻止有口令的人从 UDP 注册，挡明文注册要靠路由器不转发 5060 / 宿主机防火墙
APP_TLS_ONLY=no
# 第二个分机（iPhone 等其他 SIP 客户端），不需要就留空
EXT2=102
# 回声测试号码：TEST_ECHO=yes 时分机拨 TEST_ECHO_EXT 听到自己的声音，验证完建议关掉
TEST_ECHO=no
TEST_ECHO_EXT=*43

# ---- AMI（只给 phonebox 用，只监听 127.0.0.1） ----
AMI_PORT=5038

# ---- phonebox 网页 / App 接口 ----
# 监听地址：默认只给本机反代；局域网直连可填本机局域网 IP（如 192.168.1.10）
PHONEBOX_BIND=127.0.0.1
PHONEBOX_PORT=18989
# 浏览器和 App 访问网页的完整地址（协议+域名+端口），登录和签发 App 令牌时校验
PHONEBOX_ORIGIN=https://sms.example.com
# 联网查号：离线库没收录的来电号码发给 PixelTelo 公开接口查询（只发号码）。填 off 关闭，留空用默认接口
PHONEBOX_TELO_URL=

# ---- 4G 模块（chan_quectel） ----
QUECTEL_AUDIO=/dev/ttyUSB1
QUECTEL_DATA=/dev/ttyUSB2

# ---- 短信唤醒（App 离线时发 PBWAKE 短信叫醒它） ----
# quectel = 经 4G 模块真发短信；stub = 只写日志（测试）
WAKE_METHOD=quectel
WAKE_INTERVAL=300
WAKE_WAIT=12

# ---- 短信推送（可选） ----
# none / generic / bark / ntfy，见 asterisk/scripts/sms-notify.sh 文件头
NOTIFY_KIND=none
# 例：bark → https://api.day.app/<设备key>；ntfy → https://ntfy.sh/<主题>；generic → 你的通知网关 URL
NOTIFY_URL=
# generic / ntfy 的 Bearer 令牌，没有就留空
NOTIFY_TOKEN=

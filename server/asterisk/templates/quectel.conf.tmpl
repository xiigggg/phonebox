; chan_quectel 配置，由 scripts/init.sh 按 .env 渲染。
; 没接 4G 模块时 quectel show devices 会显示设备不可用，这不影响 SIP 和 phonebox。
[general]
interval=15

[defaults]
context=quectel-incoming
exten=s
group=0
; 模块经 USB 送来的语音偏响：EC20 实测语音段约 -9.5 dBFS、峰值接近满幅，手机上听着爆音。
; 注意 chan_quectel 的负值是“除以倍数”而不是分贝：-3 = 除以 3 ≈ -9.5 dB，调完约 -19 dBFS。
; 模块的 AT+CLVL / AT+QRXGAIN 只管模拟口，对 USB 音频无效，所以在这里衰减。
rxgain=-3
txgain=0
autodeletesms=yes
resetdongle=yes
u2diag=-1
callingpres=allowed_passed_screen
disablesms=no
language=zh_CN
smsaspdu=yes
mindtmfgap=45
mindtmfduration=80
mindtmfinterval=200
callwaiting=auto
disable=no
initstate=start
dtmf=relax

[quectel0]
audio={{QUECTEL_AUDIO}}
data={{QUECTEL_DATA}}

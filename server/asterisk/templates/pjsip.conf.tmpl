; 由 scripts/init.sh 按 .env 渲染，不要直接改渲染结果（下次 init.sh 会覆盖）；要改就改模板或 .env。
[global]
type=global
user_agent=phonebox

[transport-udp]
type=transport
protocol=udp
bind={{SIP_BIND}}:{{SIP_UDP_PORT}}
{{#EXTERNAL_ADDRESS}}
external_media_address={{EXTERNAL_ADDRESS}}
external_signaling_address={{EXTERNAL_ADDRESS}}
external_signaling_port={{SIP_UDP_PUBLIC_PORT}}
local_net={{LOCAL_NET}}
{{/EXTERNAL_ADDRESS}}

; App 推荐走 TLS：证书由 scripts/gen-tls-cert.sh 生成，App 向导里按 SHA-256 指纹固定。
; pjsip 的 method 只能选一个版本；tlsv1_2 所有 Android 都支持。
[transport-tls]
type=transport
protocol=tls
bind={{SIP_BIND}}:{{SIP_TLS_PORT}}
cert_file=/etc/asterisk/keys/asterisk.crt
priv_key_file=/etc/asterisk/keys/asterisk.key
method=tlsv1_2
{{#EXTERNAL_ADDRESS}}
external_media_address={{EXTERNAL_ADDRESS}}
external_signaling_address={{EXTERNAL_ADDRESS}}
external_signaling_port={{SIP_TLS_PUBLIC_PORT}}
local_net={{LOCAL_NET}}
{{/EXTERNAL_ADDRESS}}
{{#SIP_TCP}}

[transport-tcp]
type=transport
protocol=tcp
bind={{SIP_BIND}}:{{SIP_UDP_PORT}}
{{#EXTERNAL_ADDRESS}}
external_media_address={{EXTERNAL_ADDRESS}}
external_signaling_address={{EXTERNAL_ADDRESS}}
external_signaling_port={{SIP_UDP_PUBLIC_PORT}}
local_net={{LOCAL_NET}}
{{/EXTERNAL_ADDRESS}}
{{/SIP_TCP}}

[endpoint-basic](!)
type=endpoint
context=from-internal
disallow=all
allow=opus,ulaw,alaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtmf_mode=rfc4733

[auth-userpass](!)
type=auth
auth_type=userpass

[aor-single](!)
type=aor
max_contacts=1
remove_existing=yes
qualify_frequency=30

; App 分机：SDES 乐观 SRTP（App 开了 SRTP 就加密，没开也能接通）
[{{APP_EXT}}](endpoint-basic)
auth={{APP_EXT}}-auth
aors={{APP_EXT}}
media_encryption=sdes
media_encryption_optimistic=yes
{{#APP_TLS_ONLY}}
transport=transport-tls
{{/APP_TLS_ONLY}}
[{{APP_EXT}}-auth](auth-userpass)
username={{APP_EXT}}
password={{SIP_APP_PASS}}
[{{APP_EXT}}](aor-single)
{{#EXT2}}

; 第二个分机（iPhone 等其他 SIP 客户端），不需要就把 .env 的 EXT2 留空
[{{EXT2}}](endpoint-basic)
auth={{EXT2}}-auth
aors={{EXT2}}
media_encryption=sdes
media_encryption_optimistic=yes
[{{EXT2}}-auth](auth-userpass)
username={{EXT2}}
password={{SIP_EXT2_PASS}}
[{{EXT2}}](aor-single)
{{/EXT2}}

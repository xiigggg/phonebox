# 复制成 caddy/Caddyfile 后修改域名，再 docker compose --profile caddy up -d。
# 已有自己的反代（Nginx、现成的 Caddy、NAS 自带的）就不用这个容器，照着下面的要点配即可。
# 要点：
#   1. 反代到 phonebox（PHONEBOX_BIND:PHONEBOX_PORT，默认 127.0.0.1:18989）
#   2. /api/lookup、/api/sms-score 只给本机 Asterisk 用，公网一律 404
#   3. /api/events 是 SSE 长连接；Caddy 2 遇到 text/event-stream 会自动立即刷新，
#      若发现事件延迟，在 reverse_proxy 块里加 flush_interval -1
# .env 的 PHONEBOX_ORIGIN 必须等于这里对外的地址（例：https://sms.example.com）

sms.example.com {
    header {
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Strict-Transport-Security "max-age=31536000"
    }

    @private_api path /api/lookup* /api/sms-score*
    respond @private_api "Not found" 404

    # 可选：App 内更新的 APK 托管目录（${DATA_DIR}/app-update，放 version.json 和 APK）
    handle_path /app-update/* {
        root * /srv/phonebox-update
        @manifest path /version.json
        header @manifest Cache-Control "no-cache"
        @apk path *.apk
        header @apk Content-Type application/vnd.android.package-archive
        file_server
    }

    reverse_proxy 127.0.0.1:18989 {
        # flush_interval -1
    }
}
